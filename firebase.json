{
  "hosting": {
    "site": "estudiotaller",
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "predeploy": [
      "cp \"$PROJECT_DIR/slides/taller_ia_slides.json\" \"$PROJECT_DIR/public/data/taller_ia_slides.json\"",
      "date +%s > \"$PROJECT_DIR/public/version.json\""
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/participar.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.woff2",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5050
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
