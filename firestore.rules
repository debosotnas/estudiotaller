rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() {
      return request.auth.token.get('email', '');
    }
    function conGoogle() {
      return request.auth != null && request.auth.token.get('email_verified', false) == true;
    }
    function esAdmin() {
      return conGoogle() && email() in ['obed.santos@gmail.com'];
    }
    // Personas autorizadas a crear presentaciones (las agrega el superadmin)
    function esUsuario() {
      return esAdmin() || (conGoogle() && exists(/databases/$(database)/documents/estudiotaller_usuarios/$(email())));
    }
    function ficha(sid) {
      return /databases/$(database)/documents/estudiotaller_presentaciones/$(sid);
    }
    // Dueño o coeditor de la presentación (o superadmin)
    function puedeEditar(sid) {
      return esAdmin() || (conGoogle() && exists(ficha(sid))
        && (get(ficha(sid)).data.owner == request.auth.uid || email() in get(ficha(sid)).data.editores));
    }

    match /estudiotaller_usuarios/{e} {
      allow read: if esAdmin() || (conGoogle() && e == email());
      allow write: if esAdmin();
    }

    // Ficha de cada presentación: título, dueño, coeditores, tema
    match /estudiotaller_presentaciones/{sid} {
      allow get: if true;
      allow list: if conGoogle();
      // se crea solo para una sesión nueva (no se puede «adueñar» una que ya existe)
      allow create: if esAdmin() || (esUsuario()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.ownerEmail == email()
        && request.resource.data.editores is list
        && !exists(/databases/$(database)/documents/estudiotaller/$(sid)));
      // los coeditores pueden cambiar título, tema y coeditores, pero no el dueño
      allow update: if esAdmin() || (puedeEditar(sid) && request.resource.data.owner == resource.data.owner
        && request.resource.data.ownerEmail == resource.data.ownerEmail);
      allow delete: if esAdmin() || (conGoogle() && resource.data.owner == request.auth.uid);
    }

    // estudiotaller/{sesion}: lo que miran los celulares (actividad abierta, vista compartida)
    match /estudiotaller/{sid} {
      allow read: if true;
      allow write: if puedeEditar(sid);

      // config/contenido (diapositivas) y config/presentador (navegación)
      match /config/{doc} {
        allow read: if true;
        allow write: if puedeEditar(sid);
      }

      // pizarrones: los dibuja el presentador; los trazos terminados los pueden ver todos (celulares)
      match /pizarrones/{n} {
        allow read: if true;
        allow write: if puedeEditar(sid);
        match /trazos/{t} {
          allow read: if true;
          allow write: if puedeEditar(sid);
        }
      }
      // preguntas del público: las ven todos; cada participante crea las suyas con la actividad abierta;
      // quien edita las modera (ocultar / respondida)
      match /preguntas/{q} {
        function sesionQA() {
          return get(/databases/$(database)/documents/estudiotaller/$(sid)).data;
        }
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'actividad', 'texto', 'nombre', 'ts'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 200
          && (request.resource.data.nombre == null || (request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40))
          && request.resource.data.ts == request.time
          && sesionQA().abierta == true && sesionQA().actividad == request.resource.data.actividad;
        allow update: if puedeEditar(sid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['oculta', 'respondida']);
        allow delete: if puedeEditar(sid) || (request.auth != null && resource.data.uid == request.auth.uid);
      }
      // votos: {pregunta}__{uid}; cada uno ve solo los suyos (la consola los cuenta)
      match /votos/{v} {
        function sesionV() {
          return get(/databases/$(database)/documents/estudiotaller/$(sid)).data;
        }
        allow read: if puedeEditar(sid) || (request.auth != null && resource.data.uid == request.auth.uid);
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['q', 'uid', 'actividad', 'ts'])
          && request.resource.data.uid == request.auth.uid
          && v == request.resource.data.q + '__' + request.auth.uid
          && request.resource.data.ts == request.time
          && sesionV().abierta == true && sesionV().actividad == request.resource.data.actividad;
        allow delete: if puedeEditar(sid) || (request.auth != null && resource.data.uid == request.auth.uid);
      }

      // versiones guardadas del contenido: solo quienes editan
      match /versiones/{v} {
        allow read, write: if puedeEditar(sid);
      }
      // trazo en curso: solo entre la tablet y la consola
      match /pizarron_vivo/{n} {
        allow read, write: if puedeEditar(sid);
      }

      // respuestas/{actividad__uid}: cada participante escribe solo la suya, y solo con la actividad abierta
      match /respuestas/{rid} {
        function propia() {
          return request.auth != null && rid.matches('.+__' + request.auth.uid);
        }
        function sesion() {
          return get(/databases/$(database)/documents/estudiotaller/$(sid)).data;
        }
        function valida() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'actividad', 'nombre', 'grupo', 'valores', 'ts'])
            && d.uid == request.auth.uid
            && d.actividad is string
            && rid == d.actividad + '__' + request.auth.uid
            && d.valores is map && d.valores.size() <= 20
            && d.ts == request.time
            && (d.nombre == null || (d.nombre is string && d.nombre.size() <= 40))
            && (d.grupo == null || d.grupo in ['A', 'B', 'C', 'D'])
            && sesion().abierta == true
            && sesion().actividad == d.actividad
            && quizOk(d);
        }
        // Quiz: solo la pregunta en curso, una vez, con la hora del servidor (para el puntaje por rapidez)
        function quizOk(d) {
          let q = sesion().get('quiz', null);
          let i = q == null ? '' : string(q.i);
          let antes = resource == null ? {} : resource.data.valores;
          return q == null || q.actividad != d.actividad || (
            q.estado == 'pregunta'
            && d.valores.diff(antes).affectedKeys().hasOnly([i, 't' + i])
            && !(i in antes)
            && d.valores[i] is int
            && d.valores['t' + i] == request.time
          );
        }
        allow get: if puedeEditar(sid) || propia();
        allow list, delete: if puedeEditar(sid);
        allow create, update: if propia() && valida();
      }
    }
  }
}
